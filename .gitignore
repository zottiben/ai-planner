/target
node_modules/

# ui/dist is deliberately NOT ignored. The bundle is compiled into the binary so that
# `cargo install` works with a Rust toolchain and nothing else (D2), which means the
# built output has to be in the repo - the same bargain rule 16 makes for the skill.

*.db
*.db-wal
*.db-shm
*.bak
.DS_Store

# Harness scaffolding. `.claude/skills` is a symlink into `.agents/`, which is kept
# out of repos, so committing it would give a fresh clone a dangling link.
.claude/
.agents/
