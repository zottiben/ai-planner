{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ai-planner",
  "version": "0.4.0",
  "identifier": "dev.zottiben.ai-planner",
  "build": {
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Build plans as a board",
    "longDescription": "A kanban board over the ai-planner database. Every repo, every plan and every slice on the machine, in one window - reading and writing the same rows the aip CLI and the MCP server use.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
